---
import { Image } from 'astro:assets';
import heroImage from '../../assets/photos/bg-home-page-new.webp';
import { business } from '../../data/business';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import HeroLeadForm from '../forms/HeroLeadForm';
---

<section class="relative overflow-hidden bg-brand-950">
  <Image
    src={heroImage}
    alt="Sunset Heating & Cooling technician van and crew"
    class="absolute inset-0 h-full w-full object-cover opacity-40"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/85 to-brand-900/60"></div>

  <Container class="relative grid grid-cols-1 items-center gap-10 py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-8">
    <div class="flex min-h-[24rem] flex-col justify-center gap-6 lg:min-h-[34rem]">
      <div class="reveal-item flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-gold-500/15 px-3 py-1 text-xs font-bold uppercase tracking-wide text-gold-400 ring-1 ring-gold-500/30">
          <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M10 2l1.9 4.3 4.7.4-3.6 3.1 1.1 4.6L10 12.1l-4.1 2.3 1.1-4.6-3.6-3.1 4.7-.4z"/></svg>
          Serving Portland &amp; Dallas, OR since {business.foundingYear}
        </span>
      </div>

      <h1 class="reveal-item max-w-2xl text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Heating, Cooling, Plumbing &amp; <span class="text-accent-400">Electrical</span> Done Right
      </h1>

      <p class="reveal-item max-w-xl text-lg leading-relaxed text-white/80">
        {business.guarantee}
      </p>

      <div class="reveal-item flex flex-wrap items-center gap-4 pt-2">
        <Button href={business.phone.href} variant="accent" size="lg">
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M3.654 1.328a.678.678 0 0 1 1.015-.063l2.220 2.221a.678.678 0 0 1 .174.696l-.747 2.245a.678.678 0 0 0 .174.696l3.586 3.586a.678.678 0 0 0 .696.174l2.245-.747a.678.678 0 0 1 .696.174l2.221 2.22a.678.678 0 0 1-.063 1.015c-1.532 1.278-3.83 1.451-6.017.377-2.35-1.154-4.72-3.524-5.874-5.874-1.074-2.187-.9-4.485.377-6.017z"/></svg>
          Call {business.phone.display}
        </Button>
        <Button href="/contact" variant="outline" size="lg">Request Service</Button>
      </div>

      <dl class="reveal-item mt-6 grid max-w-md grid-cols-3 gap-4 border-t border-white/15 pt-6">
        <div>
          <dt class="sr-only">Years in business</dt>
          <dd class="count-up font-display text-3xl font-extrabold text-white" data-count-to="100" data-count-suffix="+">0</dd>
          <p class="text-xs text-white/60">Years in Oregon</p>
        </div>
        <div>
          <dt class="sr-only">Emergency availability</dt>
          <dd class="font-display text-3xl font-extrabold text-white">24/7</dd>
          <p class="text-xs text-white/60">Emergency service</p>
        </div>
        <div>
          <dt class="sr-only">BBB rating</dt>
          <dd class="font-display text-3xl font-extrabold text-white">A+</dd>
          <p class="text-xs text-white/60">BBB rating</p>
        </div>
      </dl>
    </div>

    <div class="reveal-item mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
      <HeroLeadForm client:load />
    </div>
  </Container>
</section>
