---
import { Image } from 'astro:assets';
import { business } from '../../data/business';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

const partnerImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/brand/*.webp', { eager: true });

function partnerImg(file: string) {
  const mod = Object.entries(partnerImages).find(([path]) => path.endsWith(file));
  return mod?.[1].default;
}
---

<section class="border-y border-ink-100 bg-white py-14">
  <Container class="flex flex-col gap-10">
    <div class="reveal-group grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
      {business.trustBadges.map((badge) => (
        <div class="reveal-item flex flex-col items-center gap-2 text-center">
          {badge.icon && <Icon name={badge.icon} class="h-14 w-14 text-brand-600" />}
          <p class="text-xs font-semibold leading-tight text-ink-600">{badge.label}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 border-t border-ink-100 pt-8">
      {business.partners.map((partner) => {
        const img = partnerImg(partner.logo);
        return img ? (
          <Image src={img} alt={partner.name} width={110} height={44} class="h-10 w-auto object-contain grayscale transition hover:grayscale-0" />
        ) : null;
      })}
    </div>
  </Container>
</section>
