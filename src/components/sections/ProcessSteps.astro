---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'What working with Sunset looks like',
  description = 'The same straightforward process on every job, heating, cooling, plumbing, or electrical.',
} = Astro.props;

const steps = [
  {
    step: '1',
    title: 'Call or request online',
    copy: 'Reach a real person 24/7, or send a quick request online and our team follows up to schedule.',
  },
  {
    step: '2',
    title: 'We diagnose and quote',
    copy: 'A licensed technician inspects the problem and gives you flat-rate pricing before any work begins, no surprises on the invoice.',
  },
  {
    step: '3',
    title: 'We fix it right',
    copy: 'Work is completed by background-checked, uniformed technicians who treat your home like their own.',
  },
  {
    step: '4',
    title: 'Backed by our warranty',
    copy: 'Every job is covered by our Lifetime Limited Warranty, so you are protected long after we leave.',
  },
];
---

<section class="py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading align="center" eyebrow="How it works" title={title} description={description} />
    <div class="reveal-group grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <div class="reveal-item relative flex flex-col gap-2 rounded-xl border border-ink-100 bg-white p-6">
          <span class="font-display text-4xl font-extrabold text-ink-100">{s.step}</span>
          <h3 class="font-display text-base font-bold text-ink-900">{s.title}</h3>
          <p class="text-sm leading-relaxed text-ink-500">{s.copy}</p>
          {i < steps.length - 1 && (
            <svg viewBox="0 0 20 20" class="absolute -right-4 top-1/2 hidden h-6 w-6 -translate-y-1/2 text-ink-200 lg:block" fill="currentColor" aria-hidden="true">
              <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </div>
      ))}
    </div>
  </Container>
</section>
