---
import { serviceCategories, servicesByCategory } from '../../data/services';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
---

<section class="bg-ink-50 py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading
      align="center"
      eyebrow="What we do"
      title="Four trades. One trusted team."
      description="Sunset handles the systems that keep your home comfortable, safe, and running, heating, cooling, plumbing, and electrical, all from one licensed company."
    />

    <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {serviceCategories.map((cat) => (
        <a
          href={`/${cat.slug}`}
          class="spotlight-card reveal-item group flex flex-col gap-4 rounded-xl border border-ink-100 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="relative z-10 text-brand-600 transition-colors group-hover:text-accent-600">
            <Icon name={cat.icon} class="h-16 w-16" />
          </div>
          <div class="relative z-10">
            <h3 class="font-display text-lg font-bold text-ink-900">{cat.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{cat.description}</p>
          </div>
          <div class="relative z-10 mt-auto flex flex-wrap gap-1.5 pt-2">
            {servicesByCategory(cat.slug).slice(0, 3).map((s) => (
              <span class="rounded-full bg-ink-50 px-2.5 py-1 text-[11px] font-medium text-ink-500">{s.name}</span>
            ))}
          </div>
          <span class="relative z-10 inline-flex items-center gap-1 text-sm font-bold text-brand-600 group-hover:gap-2 transition-all">
            Explore {cat.name}
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>
