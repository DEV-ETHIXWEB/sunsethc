---
// Fully custom, dependency-free coverage map. No external tile provider, no
// API key, no third-party map library. The Oregon/Washington outline below
// is real geography, not decoration: clipped from a public US state
// boundary dataset (simplified, then projected with the exact same
// equirectangular formula used for the city points) so the state line and
// every city marker line up correctly in the same coordinate space. That
// projection and clipping happened once, offline (see git history for the
// generation script); the result is the static path data below, so there's
// no runtime dependency on any mapping service at all.
import { serviceAreas, regions } from '../../data/locations';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

// Fixed display bounds (not derived from the city data) so the real OR/WA
// outline and every city point share one coordinate space. Chosen to
// include a hint of Pacific coastline on the west edge for orientation
// while keeping the actual service-area cluster comfortably centered.
const lngMin = -124.3;
const lngMax = -121.0;
const latMin = 44.6;
const latMax = 46.0;
const latMid = (latMin + latMax) / 2;
const lngSpan = (lngMax - lngMin) * Math.cos((latMid * Math.PI) / 180);

function project(lat: number, lng: number) {
  const x = ((lng - lngMin) * Math.cos((latMid * Math.PI) / 180)) / lngSpan;
  const y = 1 - (lat - latMin) / (latMax - latMin);
  return { xPct: Math.round(x * 1000) / 10, yPct: Math.round(y * 1000) / 10 };
}

const points = serviceAreas.map((a) => ({ ...a, ...project(a.lat, a.lng) }));
const hub = points.find((p) => p.slug === 'portland')!;
const spokes = points.filter((p) => p.featured && p.slug !== 'portland');

// Real Oregon + Washington outlines, clipped to the display bounds above
// and projected into the same 0-100 space. Source: a public US state
// boundary dataset, simplified and clipped offline.
const OREGON_PATH =
  'M 45.11,2.82 L 46.6,24.34 L 62.2,32.16 L 75.48,20.81 L 83.78,19.64 L 93.4,23.55 L 94.4,28.25 L 100.0,24.81 L 100.0,100.0 L 7.04,100.0 L 7.26,95.93 L 6.77,87.71 L 9.75,61.11 L 10.92,24.34 L 9.26,3.99 L 9.75,0.0 L 44.18,0.0 L 45.11,2.82 Z';
const WASHINGTON_PATH =
  'M 94.4,28.25 L 93.4,23.55 L 83.78,19.64 L 75.48,20.81 L 62.2,32.16 L 46.6,24.34 L 45.11,2.82 L 44.18,0.0 L 100.0,0.0 L 100.0,24.81 L 94.4,28.25 Z';
const BORDER_PATH =
  'M 44.18,0.0 L 45.11,2.82 M 45.11,2.82 L 46.6,24.34 M 46.6,24.34 L 62.2,32.16 M 62.2,32.16 L 75.48,20.81 M 75.48,20.81 L 83.78,19.64 M 83.78,19.64 L 93.4,23.55 M 93.4,23.55 L 94.4,28.25 M 94.4,28.25 L 100.0,24.81';
---

<section class="py-20">
  <Container class="flex flex-col gap-8">
    <SectionHeading
      align="center"
      eyebrow="Where we work"
      title="Proudly serving the Portland metro, Mid-Willamette Valley & beyond"
      description={`${serviceAreas.length}+ cities across Oregon and Southwest Washington.`}
    />

    <div class="reveal-item flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Filter by region">
      <button type="button" data-region-filter="all" aria-pressed="true" class="region-pill rounded-full border border-brand-600 bg-brand-600 px-4 py-1.5 text-xs font-bold text-white transition-colors">
        All Regions
      </button>
      {regions.map((r) => (
        <button type="button" data-region-filter={r} aria-pressed="false" class="region-pill rounded-full border border-ink-200 bg-white px-4 py-1.5 text-xs font-semibold text-ink-600 transition-colors hover:border-brand-300 hover:text-brand-700">
          {r}
        </button>
      ))}
    </div>

    <div id="service-map" class="relative mx-auto aspect-[4/3] w-full max-w-3xl overflow-hidden rounded-2xl border border-ink-100 bg-gradient-to-b from-sky-50 to-white shadow-lg sm:aspect-[16/10]">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="ocean-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.16" />
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
          </linearGradient>
          <pattern id="land-texture" width="4" height="4" patternUnits="userSpaceOnUse">
            <rect width="4" height="4" fill="#eaecf9" />
            <circle cx="1" cy="1" r="0.15" fill="#263997" fill-opacity="0.06" />
          </pattern>
          <radialGradient id="map-glow" cx="46%" cy="55%" r="55%">
            <stop offset="0%" stop-color="#263997" stop-opacity="0.10" />
            <stop offset="100%" stop-color="#263997" stop-opacity="0" />
          </radialGradient>
        </defs>

        {/* Ocean wash on the west edge, orients the viewer before any land is drawn */}
        <rect width="100" height="100" fill="url(#ocean-fade)" />

        {/* Real Oregon + Washington landmass, Washington a touch lighter to read as the second state */}
        <path d={OREGON_PATH} fill="url(#land-texture)" stroke="#263997" stroke-width="0.35" stroke-opacity="0.5" vector-effect="non-scaling-stroke" />
        <path d={WASHINGTON_PATH} fill="#f7f7f8" stroke="#263997" stroke-width="0.35" stroke-opacity="0.5" vector-effect="non-scaling-stroke" />
        <path d={BORDER_PATH} fill="none" stroke="#735800" stroke-width="0.45" stroke-dasharray="1.4 1" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />

        <rect width="100" height="100" fill="url(#map-glow)" />

        {spokes.map((s) => (
          <line
            x1={hub.xPct} y1={hub.yPct} x2={s.xPct} y2={s.yPct}
            stroke="#263997" stroke-opacity="0.2" stroke-width="0.22"
            stroke-dasharray="1 1.2" vector-effect="non-scaling-stroke"
            data-region-line={s.region}
          />
        ))}
      </svg>

      <span class="pointer-events-none absolute left-[6%] top-[14%] font-display text-[11px] font-bold uppercase tracking-widest text-brand-300 sm:text-sm">WA</span>
      <span class="pointer-events-none absolute left-[6%] top-[46%] font-display text-[11px] font-bold uppercase tracking-widest text-brand-300 sm:text-sm">OR</span>

      {points.map((p) => (
        <a
          href={`/service-areas/${p.slug}`}
          data-region-point={p.region}
          data-city-name={p.name}
          class="map-point group absolute -translate-x-1/2 -translate-y-1/2 focus:z-30 focus:outline-none"
          style={`left:${p.xPct}%; top:${p.yPct}%;`}
          aria-label={`${p.name}, OR, ${p.region} service area`}
        >
          {p.featured && (
            <span class="pointer-events-none absolute inset-0 -m-1.5 animate-ping rounded-full bg-accent-400/50 [animation-duration:2.5s]"></span>
          )}
          <span
            class:list={[
              'relative block rounded-full ring-2 ring-white transition-all duration-200 group-hover:scale-[1.8] group-focus-visible:scale-[1.8]',
              p.featured ? (p.slug === 'portland' ? 'h-3.5 w-3.5 bg-brand-600 shadow-md ring-[3px]' : 'h-3 w-3 bg-accent-400 shadow-md') : 'h-1.5 w-1.5 bg-brand-400',
            ]}
          ></span>
          <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-lg bg-brand-950 px-2.5 py-1.5 text-center opacity-0 shadow-xl transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
            <span class="block font-display text-xs font-bold text-white">{p.name}</span>
            <span class="block text-[10px] text-white/60">{p.region}</span>
            <span class="absolute left-1/2 top-full -mt-px h-2 w-2 -translate-x-1/2 rotate-45 bg-brand-950"></span>
          </span>
        </a>
      ))}

      <div class="pointer-events-none absolute left-3 top-3 rounded-lg bg-white/90 px-3 py-2 shadow-md ring-1 ring-ink-100 backdrop-blur-sm">
        <p class="font-display text-lg font-extrabold leading-none text-brand-900">{serviceAreas.length}+</p>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-500">Cities served</p>
      </div>

      <div class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-3 rounded-lg bg-white/90 px-3 py-1.5 text-[10px] font-semibold text-ink-600 shadow-md ring-1 ring-ink-100 backdrop-blur-sm">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent-400"></span>Most-served</span>
        <span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>Service area</span>
      </div>
    </div>

    <p class="text-center text-xs text-ink-400">Hover or tap any point for the city name, click to view that service area.</p>

    <p class="text-center">
      <a href="/service-areas" class="font-bold text-brand-600 hover:text-brand-700">Browse every service area &rarr;</a>
    </p>
  </Container>
</section>

<style>
  #service-map:has(.map-point:hover) .map-point:not(:hover),
  #service-map:has(.map-point:focus-visible) .map-point:not(:focus-visible) {
    opacity: 0.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .map-point span.animate-ping {
      animation: none;
    }
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-region-filter]');
  const points = document.querySelectorAll<HTMLElement>('.map-point');
  const lines = document.querySelectorAll<SVGLineElement>('[data-region-line]');

  function applyFilter(region: string) {
    points.forEach((p) => {
      const match = region === 'all' || p.dataset.regionPoint === region;
      p.style.opacity = match ? '1' : '0.15';
      p.style.pointerEvents = match ? 'auto' : 'none';
    });
    lines.forEach((l) => {
      const match = region === 'all' || l.dataset.regionLine === region;
      l.style.opacity = match ? '1' : '0.08';
    });
    pills.forEach((btn) => {
      const active = btn.dataset.regionFilter === region;
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('border-brand-600', active);
      btn.classList.toggle('bg-brand-600', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-ink-200', !active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-ink-600', !active);
    });
  }

  pills.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.regionFilter || 'all'));
  });
</script>
