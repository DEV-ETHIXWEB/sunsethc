---
// Real Sunset logo mark (sunburst + service icons), background-removed from
// the client’s saved brand asset (src/assets/photos/sunsethc-logo.webp) so
// it drops cleanly onto both the light header and dark footer.
import { Image } from 'astro:assets';
import logoMark from '../../assets/brand/logo-mark.webp';
import { business } from '../../data/business';

interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = 'h-14 w-14' } = Astro.props;
---

<span class="inline-flex min-w-0 items-center gap-3.5">
  <Image src={logoMark} alt="" class={`${className} shrink-0`} width={200} height={200} />
  <span class:list={['min-w-0 font-display leading-tight', variant === 'dark' ? 'text-white' : 'text-ink-900']}>
    <span class="block truncate text-xl font-extrabold tracking-tight sm:text-2xl">{business.name}</span>
    <span class:list={['hidden truncate text-[15px] font-semibold uppercase tracking-wide sm:block', variant === 'dark' ? 'text-gold-400' : 'text-accent-600']}>
      Heating &middot; Cooling &middot; Plumbing &middot; Electrical
    </span>
  </span>
</span>
