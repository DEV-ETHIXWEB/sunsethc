---
// Floating accessibility widget aimed squarely at older/lower-vision
// visitors, bigger text, high contrast, grayscale, underlined links, a
// dyslexia/readable font, paused animations, and a large cursor. Settings
// persist in localStorage and are re-applied by an early, synchronous
// script in Layout.astro’s <head> so there’s no flash of unstyled content
// on repeat visits.
import { business } from '../../data/business';

interface ToggleDef {
  key: 'bigText' | 'contrast' | 'grayscale' | 'underlineLinks' | 'readableFont' | 'motion' | 'largeCursor';
  label: string;
}

const toggles: ToggleDef[] = [
  { key: 'bigText', label: 'Bigger text' },
  { key: 'contrast', label: 'High contrast' },
  { key: 'grayscale', label: 'Grayscale' },
  { key: 'underlineLinks', label: 'Underline links' },
  { key: 'readableFont', label: 'Readable font' },
  { key: 'motion', label: 'Pause animations' },
  { key: 'largeCursor', label: 'Large cursor' },
];
---

<div
  id="a11y-widget"
  class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] left-4 z-[60] md:bottom-4"
>
  <button
    type="button"
    id="a11y-toggle"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Accessibility options"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-white shadow-lg transition-transform hover:scale-105 hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
  >
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="4" r="2" />
      <path d="M4.5 8.25a1 1 0 0 1 .82-.98L12 6l6.68 1.27a1 1 0 0 1-.36 1.97L13 8.3v3.4l3.4 7.53a1 1 0 1 1-1.82.83L12 14.7l-2.58 5.36a1 1 0 1 1-1.82-.83L11 11.7V8.3l-5.32-.9a1 1 0 0 1-.86-1.15z" />
    </svg>
  </button>

  <div
    id="a11y-panel"
    role="dialog"
    aria-label="Accessibility options"
    hidden
    class="absolute bottom-16 left-0 flex max-h-[32rem] w-[22rem] max-w-[calc(100vw-2rem)] flex-col overflow-hidden rounded-xl border border-ink-100 bg-white shadow-2xl"
  >
    <div class="flex items-center justify-between bg-brand-900 px-4 py-3.5 text-white">
      <p class="font-display text-base font-bold">Accessibility Options</p>
      <button type="button" id="a11y-close" aria-label="Close accessibility options" class="rounded-md p-1 hover:bg-white/10">
        <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-3">
      <div class="flex flex-col gap-2">
        {toggles.map((t) => (
          <button
            type="button"
            data-a11y-toggle={t.key}
            aria-pressed="false"
            class="flex items-center justify-between rounded-lg border border-ink-200 px-3.5 py-3 text-left transition-colors hover:border-brand-300 hover:bg-brand-50 aria-pressed:border-brand-500 aria-pressed:bg-brand-50"
          >
            <span class="font-display text-sm font-bold text-brand-900">{t.label}</span>
            <span data-a11y-state class="text-xs font-bold uppercase tracking-wide text-ink-400">Off</span>
          </button>
        ))}

        <button
          type="button"
          id="a11y-reset"
          class="mt-1 flex items-center justify-center gap-1.5 rounded-lg border border-dashed border-ink-300 px-3.5 py-2.5 text-sm font-semibold text-ink-600 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700"
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 4v4h4M4 8a6 6 0 1 1 1.5 5.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Reset all
        </button>
      </div>
    </div>

    <div class="border-t border-ink-100 bg-ink-50 px-4 py-3 text-sm text-ink-600">
      <p class="mb-1 font-medium">Trouble using this site?</p>
      <a href={business.phone.href} class="font-bold text-brand-700 hover:text-brand-800">
        Call {business.phone.display}
      </a>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'a11y-prefs';

  const KEYS = ['bigText', 'contrast', 'grayscale', 'underlineLinks', 'readableFont', 'motion', 'largeCursor'] as const;
  type PrefKey = (typeof KEYS)[number];
  type Prefs = Record<PrefKey, boolean>;

  const CLASS_MAP: Record<PrefKey, string> = {
    bigText: 'a11y-big-text',
    contrast: 'a11y-high-contrast',
    grayscale: 'a11y-grayscale',
    underlineLinks: 'a11y-underline-links',
    readableFont: 'a11y-readable-font',
    motion: 'a11y-reduce-motion',
    largeCursor: 'a11y-large-cursor',
  };

  function defaults(): Prefs {
    return { bigText: false, contrast: false, grayscale: false, underlineLinks: false, readableFont: false, motion: false, largeCursor: false };
  }

  function loadPrefs(): Prefs {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) return { ...defaults(), ...JSON.parse(raw) };
    } catch {
      // localStorage unavailable (private mode, etc.), fall back to defaults.
    }
    return defaults();
  }

  function savePrefs(prefs: Prefs) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
    } catch {
      // Ignore, settings just won’t persist this session.
    }
  }

  function apply(prefs: Prefs) {
    const root = document.documentElement;
    for (const key of KEYS) {
      root.classList.toggle(CLASS_MAP[key], prefs[key]);
    }

    document.getElementById('reviews-marquee')?.classList.toggle('is-paused', prefs.motion);
    window.dispatchEvent(new CustomEvent('a11y:motion-change'));

    document.querySelectorAll<HTMLElement>('[data-a11y-toggle]').forEach((btn) => {
      const key = btn.dataset.a11yToggle as PrefKey;
      const on = prefs[key];
      btn.setAttribute('aria-pressed', String(on));
      const stateEl = btn.querySelector('[data-a11y-state]');
      if (stateEl) stateEl.textContent = on ? 'On' : 'Off';
    });
  }

  let prefs = loadPrefs();
  apply(prefs);

  const widget = document.getElementById('a11y-widget');
  const toggleBtn = document.getElementById('a11y-toggle');
  const closeBtn = document.getElementById('a11y-close');
  const panel = document.getElementById('a11y-panel');
  const resetBtn = document.getElementById('a11y-reset');

  function update(partial: Partial<Prefs>) {
    prefs = { ...prefs, ...partial };
    apply(prefs);
    savePrefs(prefs);
  }

  function closePanel() {
    toggleBtn?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
  }

  toggleBtn?.addEventListener('click', () => {
    const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!expanded));
    panel?.toggleAttribute('hidden', expanded);
  });

  closeBtn?.addEventListener('click', closePanel);

  document.addEventListener('click', (e) => {
    if (widget && !e.composedPath().includes(widget)) closePanel();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.a11yToggle as PrefKey;
      update({ [key]: !prefs[key] } as Partial<Prefs>);
    });
  });

  resetBtn?.addEventListener('click', () => update(defaults()));
</script>
