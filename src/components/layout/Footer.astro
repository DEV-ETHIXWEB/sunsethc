---
import { Image } from 'astro:assets';
import bbbLogo from '../../assets/brand/bbb-logo.webp';
import { business } from '../../data/business';
import { footerNav } from '../../data/navigation';
import { featuredServiceAreas } from '../../data/locations';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-ink-300">
  <Container class="grid grid-cols-2 gap-x-6 gap-y-10 py-14 sm:gap-x-10 lg:grid-cols-5">
    <div class="col-span-2 lg:col-span-2">
      <a href="/" class="mb-4 inline-flex items-center" aria-label={`${business.name} home`}>
        <Logo variant="dark" />
      </a>
      <p class="mb-4 max-w-sm text-sm leading-relaxed text-ink-400">
        {business.legalName} has proudly served Portland, Dallas, OR and the surrounding region since {business.foundingYear}.
        Licensed, bonded, and insured. {business.tagline}.
      </p>
      <div class="flex flex-col gap-1.5 text-sm">
        <a href={business.phone.href} class="w-fit font-semibold text-gold-500 hover:text-gold-400">
          {business.phone.display}
        </a>
        <a
          href={business.address.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit hover:text-white"
        >
          {business.address.street}, {business.address.city}, {business.address.state} {business.address.zip}
        </a>
        <a href={`mailto:${business.email}`} class="w-fit hover:text-white">{business.email}</a>
      </div>
    </div>

    <div>
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-white">Services</h3>
      <ul class="flex flex-col gap-2.5 text-sm">
        {footerNav.services.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-white">Company</h3>
      <ul class="flex flex-col gap-2.5 text-sm">
        {footerNav.company.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-white">Service Areas</h3>
      <ul class="flex flex-col gap-2.5 text-sm">
        {featuredServiceAreas.slice(0, 8).map((area) => (
          <li><a href={`/service-areas/${area.slug}`} class="hover:text-white">{area.name}</a></li>
        ))}
        <li><a href="/service-areas" class="font-semibold text-brand-300 hover:text-brand-200">View all areas &rarr;</a></li>
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container class="flex flex-col items-center justify-between gap-4 py-6 text-xs text-ink-400 sm:flex-row">
      <div class="flex flex-col items-center gap-1 sm:items-start">
        <p>&copy; {business.foundingYear}&ndash;{year} {business.name}. All rights reserved.</p>
        <p>Oregon CCB License #{business.license.number}</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {footerNav.legal.map((link) => (
          <a href={link.href} class="hover:text-white">{link.label}</a>
        ))}
        <a href={business.bbb.profileUrl} target="_blank" rel="noopener noreferrer" aria-label="BBB Accredited Business Profile" class="flex h-11 w-11 items-center justify-center">
          <Image src={bbbLogo} alt="BBB Accredited Business" width={32} height={32} class="h-8 w-8 rounded object-contain" />
        </a>
        <div class="flex items-center">
          <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.24 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06z"/></svg>
          </a>
          <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.05.25 2.5.43.6.23 1.02.5 1.47.95.45.45.72.87.95 1.47.18.45.37 1.3.43 2.5.06 1.3.07 1.7.07 4.9s-.01 3.6-.07 4.9c-.06 1.2-.25 2.05-.43 2.5-.23.6-.5 1.02-.95 1.47-.45.45-.87.72-1.47.95-.45.18-1.3.37-2.5.43-1.3.06-1.7.07-4.9.07s-3.6-.01-4.9-.07c-1.2-.06-2.05-.25-2.5-.43-.6-.23-1.02-.5-1.47-.95-.45-.45-.72-.87-.95-1.47-.18-.45-.37-1.3-.43-2.5C2.21 15.6 2.2 15.2 2.2 12s.01-3.6.07-4.9c.06-1.2.25-2.05.43-2.5.23-.6.5-1.02.95-1.47.45-.45.87-.72 1.47-.95.45-.18 1.3-.37 2.5-.43C8.4 2.21 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.52.01-4.76.07-1.03.05-1.6.22-1.97.36-.5.2-.85.42-1.22.79-.37.37-.6.72-.79 1.22-.14.37-.31.94-.36 1.97C2.83 8.48 2.82 8.86 2.82 12s.01 3.52.07 4.76c.05 1.03.22 1.6.36 1.97.2.5.42.85.79 1.22.37.37.72.6 1.22.79.37.14.94.31 1.97.36 1.24.06 1.62.07 4.76.07s3.52-.01 4.76-.07c1.03-.05 1.6-.22 1.97-.36.5-.2.85-.42 1.22-.79.37-.37.6-.72.79-1.22.14-.37.31-.94.36-1.97.06-1.24.07-1.62.07-4.76s-.01-3.52-.07-4.76c-.05-1.03-.22-1.6-.36-1.97-.2-.5-.42-.85-.79-1.22a3.29 3.29 0 0 0-1.22-.79c-.37-.14-.94-.31-1.97-.36C15.52 4.01 15.14 4 12 4z"/><path d="M12 7.6a4.4 4.4 0 1 0 0 8.8 4.4 4.4 0 0 0 0-8.8zm0 7.26a2.86 2.86 0 1 1 0-5.72 2.86 2.86 0 0 1 0 5.72zM17.8 6.7a1.03 1.03 0 1 1-2.06 0 1.03 1.03 0 0 1 2.06 0z"/></svg>
          </a>
          <a href={business.social.x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="flex h-11 w-11 items-center justify-center hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M18.24 3H21l-6.4 7.31L22 21h-6.24l-4.88-6.4L5.2 21H2.4l6.84-7.82L2 3h6.4l4.4 5.85L18.24 3zm-1.1 16.2h1.5L7.9 4.72H6.28L17.14 19.2z"/></svg>
          </a>
          <a href={business.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="flex h-11 w-11 items-center justify-center hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2s-.2-1.5-.85-2.15c-.8-.85-1.7-.85-2.1-.9C15.9 4 12 4 12 4h-.02s-3.9 0-6.65.15c-.4.05-1.3.05-2.1.9-.65.65-.85 2.15-.85 2.15S2.2 9 2.2 10.75v1.5C2.2 14 2.4 15.8 2.4 15.8s.2 1.5.85 2.15c.8.85 1.85.82 2.32.91C7.2 19 12 19 12 19s3.9 0 6.65-.15c.4-.05 1.3-.05 2.1-.9.65-.65.85-2.15.85-2.15s.2-1.8.2-3.55v-1.5c0-1.75-.2-3.55-.2-3.55zM9.95 14.4V8.6l5.3 2.9-5.3 2.9z"/></svg>
          </a>
        </div>
      </div>
    </Container>
  </div>
</footer>
