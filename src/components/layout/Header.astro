---
import { business } from '../../data/business';
import { mainNav } from '../../data/navigation';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import MobileNav from './MobileNav';

// The mega-menu dropdown is wider than a single nav item, so anchoring it
// left-0 under an item positioned far right (e.g. "Electrical") pushed it
// past the viewport edge and caused page-wide horizontal scroll. Right-align
// the dropdown for nav items past the halfway point instead.
const rightAlignFrom = Math.ceil(mainNav.length / 2);
---

<header id="site-header" class="sticky top-0 z-50 -mb-[17px] rounded-b-3xl bg-white/95 shadow-sm backdrop-blur supports-backdrop-filter:bg-white/80">
  <div class="site-header__utility hidden bg-brand-900 text-white xl:block">
    <Container class="flex items-center justify-between py-1.5 text-xs">
      <p class="font-medium tracking-wide">
        24/7 Emergency Service &middot; Licensed, Bonded &amp; Insured &middot; Serving Portland &amp; Dallas, OR Since {business.foundingYear}
      </p>
      <a href={business.phone.href} class="font-semibold text-gold-500 hover:text-gold-400">
        {business.phone.display}
      </a>
    </Container>
  </div>

  <Container class="site-header__main flex min-w-0 items-center justify-between gap-3 py-3">
    <a href="/" class="flex h-14 min-w-0 items-center" aria-label={`${business.name} home`}>
      <Logo variant="light" />
    </a>

    <nav class="hidden shrink-0 items-center gap-0.5 xl:flex" aria-label="Primary">
      {mainNav.map((item, index) => (
        <div class="group relative shrink-0">
          <a
            href={item.href}
            class="flex items-center gap-1 whitespace-nowrap rounded-md px-2 py-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
          >
            {item.label}
            {item.children && (
              <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 text-ink-400" fill="currentColor" aria-hidden="true">
                <path d="M5.5 7.5l4.5 4.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
          {item.children && (
            <div
              class:list={[
                'invisible absolute top-full z-20 max-h-[28rem] w-[28rem] max-w-[calc(100vw-2rem)] translate-y-1 overflow-y-auto rounded-lg border border-ink-100 bg-white p-3 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100',
                index >= rightAlignFrom ? 'right-0' : 'left-0',
              ]}
            >
              <div class="grid grid-cols-2 gap-x-2 gap-y-0.5">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block truncate rounded-md px-3 py-2 text-sm font-medium text-ink-600 transition-colors hover:bg-brand-50 hover:text-brand-600"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={business.phone.href}
        aria-label={`Call ${business.phone.display}`}
        class="site-header__phone-pill hidden items-center gap-2.5 whitespace-nowrap rounded-full border border-brand-100 bg-gradient-to-b from-brand-50 to-brand-100/60 py-1.5 pl-1.5 pr-4 shadow-sm transition-all hover:border-brand-200 hover:shadow-md sm:flex lg:hidden"
      >
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white shadow-sm">
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M3.654 1.328a.678.678 0 0 1 1.015-.063l2.220 2.221a.678.678 0 0 1 .174.696l-.747 2.245a.678.678 0 0 0 .174.696l3.586 3.586a.678.678 0 0 0 .696.174l2.245-.747a.678.678 0 0 1 .696.174l2.221 2.22a.678.678 0 0 1-.063 1.015c-1.532 1.278-3.83 1.451-6.017.377-2.35-1.154-4.72-3.524-5.874-5.874-1.074-2.187-.9-4.485.377-6.017z" />
          </svg>
        </span>
        <span class="font-display text-base font-extrabold tracking-tight text-brand-700 lg:text-lg">
          {business.phone.display}
        </span>
      </a>
      <MobileNav client:load business={business} mainNav={mainNav} />
    </div>
  </Container>

  <!-- The real sunsethc.com header runs a gold bar under the main nav with
       social links and two pill buttons, a distinctive part of the client's
       actual identity worth keeping rather than flattening into a generic
       template header. -->
  <div class="site-header__gold hidden rounded-b-3xl bg-gold-400 lg:block">
    <Container class="flex items-center justify-between gap-4 py-2.5">
      <div class="flex items-center gap-3.5">
        <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-brand-900/70 transition-colors hover:text-brand-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.24 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06z"/></svg>
        </a>
        <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-brand-900/70 transition-colors hover:text-brand-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.05.25 2.5.43.6.23 1.02.5 1.47.95.45.45.72.87.95 1.47.18.45.37 1.3.43 2.5.06 1.3.07 1.7.07 4.9s-.01 3.6-.07 4.9c-.06 1.2-.25 2.05-.43 2.5-.23.6-.5 1.02-.95 1.47-.45.45-.87.72-1.47.95-.45.18-1.3.37-2.5.43-1.3.06-1.7.07-4.9.07s-3.6-.01-4.9-.07c-1.2-.06-2.05-.25-2.5-.43-.6-.23-1.02-.5-1.47-.95-.45-.45-.72-.87-.95-1.47-.18-.45-.37-1.3-.43-2.5C2.21 15.6 2.2 15.2 2.2 12s.01-3.6.07-4.9c.06-1.2.25-2.05.43-2.5.23-.6.5-1.02.95-1.47.45-.45.87-.72 1.47-.95.45-.18 1.3-.37 2.5-.43C8.4 2.21 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.52.01-4.76.07-1.03.05-1.6.22-1.97.36-.5.2-.85.42-1.22.79-.37.37-.6.72-.79 1.22-.14.37-.31.94-.36 1.97C2.83 8.48 2.82 8.86 2.82 12s.01 3.52.07 4.76c.05 1.03.22 1.6.36 1.97.2.5.42.85.79 1.22.37.37.72.6 1.22.79.37.14.94.31 1.97.36 1.24.06 1.62.07 4.76.07s3.52-.01 4.76-.07c1.03-.05 1.6-.22 1.97-.36.5-.2.85-.42 1.22-.79.37-.37.6-.72.79-1.22.14-.37.31-.94.36-1.97.06-1.24.07-1.62.07-4.76s-.01-3.52-.07-4.76c-.05-1.03-.22-1.6-.36-1.97-.2-.5-.42-.85-.79-1.22a3.29 3.29 0 0 0-1.22-.79c-.37-.14-.94-.31-1.97-.36C15.52 4.01 15.14 4 12 4z"/><path d="M12 7.6a4.4 4.4 0 1 0 0 8.8 4.4 4.4 0 0 0 0-8.8zm0 7.26a2.86 2.86 0 1 1 0-5.72 2.86 2.86 0 0 1 0 5.72zM17.8 6.7a1.03 1.03 0 1 1-2.06 0 1.03 1.03 0 0 1 2.06 0z"/></svg>
        </a>
        <a href={business.social.x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-brand-900/70 transition-colors hover:text-brand-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M18.24 3H21l-6.4 7.31L22 21h-6.24l-4.88-6.4L5.2 21H2.4l6.84-7.82L2 3h6.4l4.4 5.85L18.24 3zm-1.1 16.2h1.5L7.9 4.72H6.28L17.14 19.2z"/></svg>
        </a>
        <a href={business.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-brand-900/70 transition-colors hover:text-brand-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2s-.2-1.5-.85-2.15c-.8-.85-1.7-.85-2.1-.9C15.9 4 12 4 12 4h-.02s-3.9 0-6.65.15c-.4.05-1.3.05-2.1.9-.65.65-.85 2.15-.85 2.15S2.2 9 2.2 10.75v1.5C2.2 14 2.4 15.8 2.4 15.8s.2 1.5.85 2.15c.8.85 1.85.82 2.32.91C7.2 19 12 19 12 19s3.9 0 6.65-.15c.4-.05 1.3-.05 2.1-.9.65-.65.85-2.15.85-2.15s.2-1.8.2-3.55v-1.5c0-1.75-.2-3.55-.2-3.55zM9.95 14.4V8.6l5.3 2.9-5.3 2.9z"/></svg>
        </a>
      </div>
      <div class="flex items-center gap-3">
        <a href="/contact" class="rounded-full border-2 border-brand-900 px-4 py-1.5 text-xs font-bold text-brand-900 transition-colors hover:bg-brand-900 hover:text-white">
          Book Now
        </a>
        <a href={business.phone.href} class="rounded-full bg-brand-900 px-4 py-1.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-brand-800">
          {business.phone.display}
        </a>
      </div>
    </Container>
  </div>
</header>

<style>
  .site-header__utility,
  .site-header__gold {
    overflow: hidden;
    opacity: 1;
    transition: max-height 300ms ease, opacity 200ms ease, padding-block 300ms ease;
  }

  .site-header__utility {
    max-height: 2.5rem;
  }

  .site-header__gold {
    max-height: 3.5rem;
  }

  .site-header__main {
    transition: padding-block 300ms ease;
  }

  header.is-scrolled .site-header__utility,
  header.is-scrolled .site-header__gold {
    max-height: 0;
    opacity: 0;
  }

  header.is-scrolled .site-header__main {
    padding-block: 0.625rem;
  }

  /* The gold bar's own phone pill collapses away with it on scroll, so
     bring back the compact phone pill (normally hidden at lg+ since the
     gold bar already shows a phone number there) once scrolled, instead
     of leaving the sticky header with no phone number at all. */
  @media (min-width: 1024px) {
    header.is-scrolled .site-header__phone-pill {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__utility,
    .site-header__gold,
    .site-header__main {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let ticking = false;
    const updateState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    updateState();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateState);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
