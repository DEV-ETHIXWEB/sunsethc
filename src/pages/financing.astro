---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { business } from '../data/business';
import { serviceCategories } from '../data/services';
import { siteUrl } from '../data/site';
import { breadcrumbListSchema, faqPageSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Financing', url: '/financing' },
];

const financingFaqs = [
  {
    question: 'What can I finance through Sunset?',
    answer: 'Financing is generally available for larger installations and replacements, furnaces, heat pumps, AC systems, water heaters, panel upgrades, and similar projects, rather than small individual repairs. Ask about your specific project when you request an estimate.',
  },
  {
    question: 'Does applying affect my credit score?',
    answer: 'That depends on the lender and application type, our team can walk you through what to expect before you apply. Ask when you call or request a quote.',
  },
  {
    question: 'How quickly can I find out if I am approved?',
    answer: 'Financing decisions are typically fast, often the same day, so a financed installation does not have to mean a long wait before work can start.',
  },
  {
    question: 'Can I combine financing with current coupons or specials?',
    answer: 'In many cases, yes. Mention any current offer when you apply and our team will confirm what applies to your project.',
  },
];

const schema = [breadcrumbListSchema(breadcrumbs, siteUrl), faqPageSchema(financingFaqs)];

// TODO: VERIFY before launch, confirm the specific financing partner name,
// rates, and terms with the client and update the copy below accordingly.
// The source site links out to a financing application without publishing
// on-page terms, so nothing specific is asserted here beyond what’s
// generally true of how financing works.
---

<Layout>
  <SEOHead
    slot="head"
    title="Financing | Sunset Heating & Cooling"
    description="Flexible financing options for heating, cooling, plumbing, and electrical installations from Sunset Heating & Cooling."
    path="/financing"
    jsonLd={schema}
  />

  <PageHero
    eyebrow="Comfort now, pay over time"
    title="Financing Available"
    description="Don’t let budget stand between you and a working furnace, AC, or panel upgrade."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <Container class="mx-auto flex max-w-2xl flex-col gap-5 text-center">
      <p class="text-ink-600 leading-relaxed">
        A failed furnace or a home that suddenly needs a panel upgrade rarely arrives on a convenient schedule.
        Sunset offers financing for qualifying heating, cooling, plumbing, and electrical installations, so a
        major repair or system replacement doesn’t have to be an all-at-once expense. Our team can walk you
        through available options and monthly payment estimates when you request an estimate, before any work
        is scheduled, so there are no surprises either in the price or the payment plan.
      </p>
      <p class="text-ink-600 leading-relaxed">
        Approval is based on your application, not a hard sell in your living room, and you’ll know your monthly
        payment before you commit to anything. Financing can cover the full project cost, including labor and
        equipment, so you’re not stuck choosing between the right-sized system and what fits this month’s budget.
      </p>
      <div class="flex justify-center gap-4">
        <Button href={business.phone.href} variant="primary" size="lg">Call {business.phone.display}</Button>
        <Button href="/contact" variant="ghost" size="lg" class="border-2 border-brand-200">Ask About Financing</Button>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container class="mx-auto grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="reveal-item flex flex-col gap-2 text-center">
        <span class="mx-auto font-display text-3xl font-extrabold text-ink-100">1</span>
        <h3 class="font-display text-sm font-bold text-ink-900">Get your estimate</h3>
        <p class="text-sm text-ink-500">A technician diagnoses the issue and gives you flat-rate pricing for the fix or replacement.</p>
      </div>
      <div class="reveal-item flex flex-col gap-2 text-center">
        <span class="mx-auto font-display text-3xl font-extrabold text-ink-100">2</span>
        <h3 class="font-display text-sm font-bold text-ink-900">Apply in minutes</h3>
        <p class="text-sm text-ink-500">Our team walks you through the application and typical approval turnaround on the spot.</p>
      </div>
      <div class="reveal-item flex flex-col gap-2 text-center">
        <span class="mx-auto font-display text-3xl font-extrabold text-ink-100">3</span>
        <h3 class="font-display text-sm font-bold text-ink-900">We get to work</h3>
        <p class="text-sm text-ink-500">Once approved, we schedule the job, often the same week, sometimes the same day.</p>
      </div>
    </Container>
  </section>

  <section class="bg-ink-50 py-16">
    <Container class="flex flex-col gap-8">
      <h2 class="text-center font-display text-2xl font-bold text-ink-900">Projects Financing Commonly Covers</h2>
      <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {serviceCategories.map((cat) => (
          <div class="reveal-item rounded-xl border border-ink-100 bg-white p-6 text-center shadow-sm">
            <h3 class="font-display text-base font-bold text-ink-900">{cat.name}</h3>
            <p class="mt-2 text-sm text-ink-500">{cat.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <FAQSection items={financingFaqs} title="Financing questions" />

  <FinalCTA />
</Layout>
