---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import PageHero from '../../components/sections/PageHero.astro';
import WhyChooseUs from '../../components/sections/WhyChooseUs.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import Container from '../../components/ui/Container.astro';
import { brands } from '../../data/products';
import { serviceCategories } from '../../data/services';
import { siteUrl } from '../../data/site';
import { breadcrumbListSchema, faqPageSchema } from '../../lib/seo';

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products' },
  { name: brand.name, url: `/products/${brand.slug}` },
];

const brandFaqs = [
  {
    question: `Does Sunset service ${brand.name} equipment we didn’t buy from you?`,
    answer: `Yes. Whether your ${brand.name} system was installed by Sunset or another company, our technicians can diagnose, repair, and maintain it.`,
  },
  {
    question: `How do I know if ${brand.name} is the right fit for my home?`,
    answer: 'It depends on your budget, your home’s layout, and whether you need ducted or ductless equipment. A technician can walk through the options with you during your estimate rather than steering you toward one brand by default.',
  },
  {
    question: `Does ${brand.name} equipment come with a manufacturer warranty?`,
    answer: 'Yes, in addition to any labor warranty Sunset provides, the equipment itself carries its own manufacturer warranty, details vary by model and are confirmed at the time of installation.',
  },
];

const schema = [breadcrumbListSchema(breadcrumbs, siteUrl), faqPageSchema(brandFaqs)];
---

<Layout>
  <SEOHead
    slot="head"
    title={`${brand.name} Equipment | Sunset Heating & Cooling`}
    description={brand.description}
    path={`/products/${brand.slug}`}
    jsonLd={schema}
  />

  <PageHero eyebrow={brand.headline} title={brand.name} description={brand.description} breadcrumbs={breadcrumbs} />

  <section class="py-16">
    <Container>
      <div class="mx-auto flex max-w-2xl flex-col gap-8 text-center">
        <p class="text-ink-600 leading-relaxed">{brand.description}</p>

        <div class="reveal-group grid grid-cols-1 gap-4 text-left sm:grid-cols-2">
          {brand.highlights.map((h) => (
            <div class="reveal-item flex items-start gap-3 rounded-lg border border-ink-100 bg-white p-4 shadow-sm">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0z"/></svg>
              <p class="text-sm font-medium text-ink-700">{h}</p>
            </div>
          ))}
        </div>

        <p class="text-sm text-ink-500">
          Not sure which {brand.name} model fits your home? Our technicians size equipment based on your home’s
          square footage, insulation, and layout, not a one-size-fits-all estimate, so call or request service and
          we’ll recommend the right fit.
        </p>

        <div class="flex flex-wrap justify-center gap-2">
          {serviceCategories.filter((c) => c.slug !== 'plumbing').map((cat) => (
            <a href={`/${cat.slug}`} class="rounded-full border border-ink-200 px-4 py-2 text-sm font-semibold text-ink-700 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700">
              {cat.name} Services
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <WhyChooseUs title={`Why get ${brand.name} equipment from Sunset`} />
  <FAQSection items={brandFaqs} title={`${brand.name} questions`} />

  <FinalCTA title={`Interested in ${brand.name} equipment?`} />
</Layout>
