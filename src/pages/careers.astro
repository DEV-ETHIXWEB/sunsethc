---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import PageHero from '../components/sections/PageHero.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Container from '../components/ui/Container.astro';
import { business } from '../data/business';
import { siteUrl } from '../data/site';
import { breadcrumbListSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Careers', url: '/careers' },
];
const schema = breadcrumbListSchema(breadcrumbs, siteUrl);

const values = [
  { title: 'Skilled trades, respected', copy: 'HVAC, plumbing, and electrical technicians are the backbone of what we do.' },
  { title: 'Growth over 100 years', copy: 'A century-old company still investing in training and career paths.' },
  { title: 'Family-run culture', copy: 'A team-first environment, not a faceless franchise.' },
];

// Real, currently-listed openings from the live /career-opportunities/
// page (crawled 2026-09-01), with the real descriptive text for each.
const roles = [
  { title: 'HVAC Installer', copy: 'Experienced HVAC installers who have great customer service skills and are able to work with all HVAC brands.' },
  { title: 'Electrician', copy: 'Certified electricians with excellent customer service skills.' },
  { title: 'HVAC Service Technician', copy: 'Knowledgeable in troubleshooting HVAC issues, able to repair all brands, with a focus on customer service.' },
  { title: 'HVAC Sales', copy: 'Experienced salespersons with excellent customer service skills and knowledge of HVAC.' },
  { title: 'Ductless Heat Pump Specialist', copy: 'Strong leadership and the ability to coordinate day-to-day operations.' },
];

const applyUrl = 'https://careers-sunsethc.icims.com/';

const whatWeLookFor = [
  'A valid trade license or willingness to work toward one, apprentices welcome.',
  'A clean driving record and the ability to pass a background check and drug screening.',
  'Comfort talking directly with homeowners, this is a customer-facing role, not just a back-of-house one.',
  'Reliability, our reputation depends on technicians who show up when they say they will.',
];

const benefits = [
  'Competitive, experience-based pay',
  'Steady, year-round work, not seasonal layoffs',
  'Ongoing manufacturer and trade training',
  'A fully stocked, well-maintained service vehicle',
  'Clear paths from apprentice to lead technician',
];
---

<Layout>
  <SEOHead
    slot="head"
    title="Careers | Sunset Heating & Cooling"
    description="Join the Sunset Heating & Cooling team, HVAC, plumbing, and electrical career opportunities in Portland & Dallas, OR."
    path="/careers"
    jsonLd={schema}
  />

  <PageHero
    eyebrow="Join our team"
    title="Careers at Sunset"
    description="We’re always interested in hearing from skilled HVAC, plumbing, and electrical professionals."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <p class="reveal-item mx-auto max-w-2xl text-center text-ink-600">
        “At Sunset Heating & Cooling, we like to think of our team as a family, and we are a family that is
        always growing.” We’re an Equal Opportunity Employer offering a quality working environment and a
        comprehensive benefits package to technicians who take pride in the work and treat every home like it’s
        their own.
      </p>
      <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-3">
        {values.map((v) => (
          <div class="reveal-item rounded-xl border border-ink-100 bg-white p-6 text-center shadow-sm">
            <h3 class="font-display text-base font-bold text-ink-900">{v.title}</h3>
            <p class="mt-2 text-sm text-ink-500">{v.copy}</p>
          </div>
        ))}
      </div>

      <div class="reveal-item">
        <h2 class="mb-4 text-center font-display text-xl font-bold text-ink-900">Current Openings</h2>
        <div class="reveal-group grid grid-cols-1 gap-4 sm:grid-cols-2">
          {roles.map((r) => (
            <div class="reveal-item rounded-lg border border-ink-100 bg-white p-5 shadow-sm">
              <h3 class="font-display text-sm font-bold text-ink-900">{r.title}</h3>
              <p class="mt-1.5 text-sm text-ink-500">{r.copy}</p>
            </div>
          ))}
          <a
            href={applyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-brand-300 bg-brand-50 p-5 text-center transition-colors hover:bg-brand-100"
          >
            <span class="font-display text-sm font-bold text-brand-700">Apply Online</span>
            <span class="text-xs text-brand-600">via our careers portal &rarr;</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        <div class="reveal-item">
          <h2 class="mb-4 font-display text-xl font-bold text-ink-900">What We Look For</h2>
          <ul class="flex flex-col gap-2">
            {whatWeLookFor.map((w) => (
              <li class="flex items-start gap-2 text-sm text-ink-600">
                <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0z"/></svg>
                {w}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal-item">
          <h2 class="mb-4 font-display text-xl font-bold text-ink-900">What You Get</h2>
          <ul class="flex flex-col gap-2">
            {benefits.map((b) => (
              <li class="flex items-start gap-2 text-sm text-ink-600">
                <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0z"/></svg>
                {b}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="reveal-item mx-auto max-w-xl text-center">
        <p class="text-ink-600">
          Ready to apply? Use the careers portal above, send your resume to
          <a href={`mailto:${business.email}`} class="font-semibold text-brand-600 hover:text-brand-700"> {business.email}</a>,
          or give us a call today to inquire about current openings.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href={applyUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-md bg-brand-600 px-6 py-3 font-display font-semibold text-white hover:bg-brand-700">
            Apply Online
          </a>
          <a href={business.phone.href} class="inline-block rounded-md border-2 border-brand-200 px-6 py-3 font-display font-semibold text-brand-700 hover:bg-brand-50">
            Call {business.phone.display}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <FinalCTA />
</Layout>
