---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import { services, servicesByCategory, serviceCategories } from '../../data/services';
import { featuredServiceAreas } from '../../data/locations';
import { business } from '../../data/business';
import { siteUrl } from '../../data/site';
import { categoryFaqs, generalFaqs } from '../../data/faqs';
import { breadcrumbListSchema, serviceSchema, faqPageSchema } from '../../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { category: service.category, service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const category = serviceCategories.find((c) => c.slug === service.category)!;
const related = servicesByCategory(service.category).filter((s) => s.slug !== service.slug).slice(0, 4);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: category.name, url: `/${category.slug}` },
  { name: service.name, url: `/${service.category}/${service.slug}` },
];

const faqs = (categoryFaqs[service.category] ?? generalFaqs.slice(0, 3)).slice(0, 3);

const schema = [
  breadcrumbListSchema(breadcrumbs, siteUrl),
  serviceSchema({
    serviceName: service.name,
    description: service.description,
    providerName: business.name,
    providerUrl: siteUrl,
    areaServed: featuredServiceAreas.map((a) => a.name),
    url: `${siteUrl}/${service.category}/${service.slug}`,
  }),
  faqPageSchema(faqs),
];
---

<Layout>
  <SEOHead
    slot="head"
    title={`${service.name} in Portland & Dallas, OR | Sunset Heating & Cooling`}
    description={service.shortDescription}
    path={`/${service.category}/${service.slug}`}
    jsonLd={schema}
  />

  <PageHero
    eyebrow={category.name}
    title={service.name}
    description={service.shortDescription}
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <Container class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <div class="reveal-item lg:col-span-2">
        <div class="mb-6 text-brand-600">
          <Icon name={service.icon} class="h-16 w-16" />
        </div>
        <h2 class="mb-4 font-display text-2xl font-bold text-ink-900">About This Service</h2>
        <p class="text-base leading-relaxed text-ink-600">{service.description}</p>
        <p class="mt-4 text-base leading-relaxed text-ink-600">
          {service.name} is one part of Sunset’s full {category.name.toLowerCase()} lineup, so if the problem turns
          out to be something else once a technician takes a look, we can diagnose and quote the actual fix on the
          same visit instead of sending someone else out later.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-lg border border-ink-100 bg-ink-50 p-4">
            <p class="font-display text-sm font-bold text-ink-900">Flat-Rate Pricing</p>
            <p class="mt-1 text-xs text-ink-500">Agreed before work starts, no surprises.</p>
          </div>
          <div class="rounded-lg border border-ink-100 bg-ink-50 p-4">
            <p class="font-display text-sm font-bold text-ink-900">Lifetime Limited Warranty</p>
            <p class="mt-1 text-xs text-ink-500">Every job is backed, not just the equipment.</p>
          </div>
          <div class="rounded-lg border border-ink-100 bg-ink-50 p-4">
            <p class="font-display text-sm font-bold text-ink-900">24/7 Availability</p>
            <p class="mt-1 text-xs text-ink-500">Emergency service, day or night.</p>
          </div>
        </div>

        {service.signs && (
          <div class="mt-10">
            <h2 class="mb-3 font-display text-xl font-bold text-ink-900">Signs You Need {service.name}</h2>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {service.signs.map((s) => (
                <li class="flex items-start gap-2 rounded-lg bg-ink-50 px-3 py-2.5 text-sm text-ink-700">
                  <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 6v5M10 14h.01" stroke-linecap="round" /><path d="M8.6 3.5 1.9 15a1.5 1.5 0 0 0 1.3 2.2h13.6a1.5 1.5 0 0 0 1.3-2.2L11.4 3.5a1.5 1.5 0 0 0-2.8 0Z" stroke-linejoin="round" /></svg>
                  {s}
                </li>
              ))}
            </ul>
          </div>
        )}

        {service.benefits && (
          <div class="mt-10">
            <h2 class="mb-3 font-display text-xl font-bold text-ink-900">What’s Included</h2>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {service.benefits.map((b) => (
                <li class="flex items-start gap-2 rounded-lg bg-ink-50 px-3 py-2.5 text-sm text-ink-700">
                  <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0z"/></svg>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        )}

        {service.process && (
          <div class="mt-10">
            <h2 class="mb-3 font-display text-xl font-bold text-ink-900">Our Process</h2>
            <ol class="flex flex-col gap-2">
              {service.process.map((step, i) => (
                <li class="flex items-start gap-3 rounded-lg bg-ink-50 px-3 py-2.5 text-sm text-ink-700">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[11px] font-bold text-white">{i + 1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        )}

        <div class="mt-10 rounded-xl border border-ink-100 bg-white p-6 shadow-sm">
          <h3 class="mb-2 font-display text-lg font-bold text-ink-900">Serving these areas &amp; more</h3>
          <div class="flex flex-wrap gap-2">
            {featuredServiceAreas.map((a) => (
              <a href={`/service-areas/${a.slug}`} class="rounded-full bg-ink-50 px-3 py-1.5 text-xs font-semibold text-ink-600 hover:bg-brand-50 hover:text-brand-700">
                {a.name}
              </a>
            ))}
          </div>
          <a href="/service-areas" class="mt-3 inline-block text-sm font-bold text-brand-600 hover:text-brand-700">View all service areas &rarr;</a>
        </div>
      </div>

      <aside class="reveal-item flex flex-col gap-5">
        <div class="rounded-xl bg-brand-900 p-6 text-white">
          <h3 class="font-display text-lg font-bold text-white">Need {service.name.toLowerCase()}?</h3>
          <p class="mt-2 text-sm text-white/75">Call now for fast, flat-rate {category.name.toLowerCase()} service.</p>
          <Button href={business.phone.href} variant="accent" size="md" class="mt-4 w-full">
            Call {business.phone.display}
          </Button>
          <Button href="/contact" variant="outline" size="md" class="mt-2 w-full">Request Service</Button>
        </div>

        {related.length > 0 && (
          <div class="rounded-xl border border-ink-100 bg-white p-6">
            <h3 class="mb-3 font-display text-sm font-bold uppercase tracking-wide text-ink-500">
              Related {category.name} Services
            </h3>
            <ul class="flex flex-col gap-2">
              {related.map((r) => (
                <li><a href={`/${r.category}/${r.slug}`} class="text-sm font-semibold text-brand-700 hover:text-brand-800">{r.name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </Container>
  </section>

  <ProcessSteps title={`Getting ${service.name.toLowerCase()} from Sunset`} />
  <FAQSection items={faqs} title={`${category.name} questions`} />

  <FinalCTA
    title={`Ready to schedule ${service.name.toLowerCase()}?`}
    description="Flat-rate pricing, 24/7 emergency service, and a Lifetime Limited Warranty on every job."
  />
</Layout>
