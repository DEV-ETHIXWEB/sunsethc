---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import WhyChooseUs from '../../components/sections/WhyChooseUs.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import { serviceCategories, servicesByCategory } from '../../data/services';
import { featuredServiceAreas } from '../../data/locations';
import { categoryFaqs, generalFaqs } from '../../data/faqs';
import { siteUrl } from '../../data/site';
import { breadcrumbListSchema, faqPageSchema } from '../../lib/seo';

export function getStaticPaths() {
  return serviceCategories.map((cat) => ({
    params: { category: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const categoryServices = servicesByCategory(cat.slug);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: cat.name, url: `/${cat.slug}` },
];
const faqs = categoryFaqs[cat.slug] ?? generalFaqs.slice(0, 3);
const schema = [breadcrumbListSchema(breadcrumbs, siteUrl), faqPageSchema(faqs)];
---

<Layout>
  <SEOHead
    slot="head"
    title={`${cat.name} Services in Portland & Dallas, OR | Sunset Heating & Cooling`}
    description={cat.description}
    path={`/${cat.slug}`}
    jsonLd={schema}
  />

  <PageHero
    eyebrow={cat.name}
    title={`${cat.name} Services`}
    description={cat.description}
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <Container>
      <p class="reveal-item mx-auto mb-12 max-w-3xl text-center text-base leading-relaxed text-ink-600">
        {cat.intro}
      </p>

      {(cat.warningSigns || cat.commonProblems) && (
        <div class="reveal-group mx-auto mb-12 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
          {cat.commonProblems && (
            <div class="reveal-item rounded-xl border border-ink-100 bg-ink-50 p-6">
              <h2 class="mb-3 font-display text-base font-bold text-ink-900">Common {cat.name} Problems We Fix</h2>
              <ul class="flex flex-col gap-2">
                {cat.commonProblems.map((p) => (
                  <li class="flex items-start gap-2 text-sm text-ink-600">
                    <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 6v5M10 14h.01" stroke-linecap="round" /><path d="M8.6 3.5 1.9 15a1.5 1.5 0 0 0 1.3 2.2h13.6a1.5 1.5 0 0 0 1.3-2.2L11.4 3.5a1.5 1.5 0 0 0-2.8 0Z" stroke-linejoin="round" /></svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {cat.warningSigns && (
            <div class="reveal-item rounded-xl border border-ink-100 bg-ink-50 p-6">
              <h2 class="mb-3 font-display text-base font-bold text-ink-900">Signs You Need {cat.name} Service</h2>
              <ul class="flex flex-col gap-2">
                {cat.warningSigns.map((s) => (
                  <li class="flex items-start gap-2 text-sm text-ink-600">
                    <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 6v5M10 14h.01" stroke-linecap="round" /><path d="M8.6 3.5 1.9 15a1.5 1.5 0 0 0 1.3 2.2h13.6a1.5 1.5 0 0 0 1.3-2.2L11.4 3.5a1.5 1.5 0 0 0-2.8 0Z" stroke-linejoin="round" /></svg>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {categoryServices.map((service) => (
          <a
            href={`/${service.category}/${service.slug}`}
            class="spotlight-card reveal-item group flex flex-col gap-3 rounded-xl border border-ink-100 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="relative z-10 text-brand-600 transition-colors group-hover:text-accent-600">
              <Icon name={service.icon} class="h-14 w-14" />
            </div>
            <h2 class="relative z-10 font-display text-lg font-bold text-ink-900">{service.name}</h2>
            <p class="relative z-10 text-sm leading-relaxed text-ink-500">{service.shortDescription}</p>
            <span class="relative z-10 mt-auto inline-flex items-center gap-1 text-sm font-bold text-brand-600 group-hover:gap-2 transition-all">
              Learn more
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <ProcessSteps title={`Getting ${cat.name.toLowerCase()} service from Sunset`} />
  <WhyChooseUs title={`Why Portland & Dallas homeowners trust Sunset for ${cat.name.toLowerCase()}`} />

  <section class="bg-ink-50 py-16">
    <Container class="flex flex-col items-center gap-6 text-center">
      <h2 class="font-display text-2xl font-bold text-ink-900">{cat.name} Service Areas</h2>
      <div class="flex flex-wrap justify-center gap-2">
        {featuredServiceAreas.map((area) => (
          <a href={`/service-areas/${area.slug}`} class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-700 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700">
            {area.name}
          </a>
        ))}
      </div>
      <a href="/service-areas" class="text-sm font-bold text-brand-600 hover:text-brand-700">View all service areas &rarr;</a>
    </Container>
  </section>

  <FAQSection items={faqs} title={`${cat.name} questions`} />
  <FinalCTA />
</Layout>
