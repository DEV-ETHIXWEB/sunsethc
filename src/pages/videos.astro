---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import PageHero from '../components/sections/PageHero.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Container from '../components/ui/Container.astro';
import { business } from '../data/business';
import { siteUrl } from '../data/site';
import { breadcrumbListSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Videos', url: '/videos' },
];
const schema = breadcrumbListSchema(breadcrumbs, siteUrl);

const topics = [
  { title: 'Maintenance tips', copy: 'Simple checks homeowners can do between professional tune-ups, like when to change a filter or what a healthy thermostat cycle looks like.' },
  { title: 'What to expect', copy: 'A look at how a real Sunset installation or repair visit goes, from the initial estimate to the final walkthrough.' },
  { title: 'Behind the scenes', copy: 'Meet the technicians and teams working across Portland and Dallas, OR, and see what a day in the field actually looks like.' },
  { title: 'Product walkthroughs', copy: 'A closer look at the Daikin, Mitsubishi, and Trane equipment we install, and what sets each apart.' },
  { title: 'Warning signs', copy: 'Visual cues, sounds, and smells that mean it is time to call, before a small issue becomes an emergency.' },
  { title: 'Customer stories', copy: 'Real homeowners talking about their experience working with Sunset, in their own words.' },
];
---

<Layout>
  <SEOHead
    slot="head"
    title="Videos | Sunset Heating & Cooling"
    description="Watch Sunset Heating & Cooling videos on our YouTube channel."
    path="/videos"
    jsonLd={schema}
  />

  <PageHero eyebrow="Watch & learn" title="Videos" breadcrumbs={breadcrumbs} />

  <section class="py-16">
    <Container>
      <div class="mx-auto flex max-w-xl flex-col items-center gap-4 text-center">
        <p class="text-ink-600">
          {/* TODO: ASSET REQUIRED, embed specific video IDs here once provided; linking out to the channel in the meantime rather than guessing at content. */}
          Sometimes it is easier to see it than read about it. Our YouTube channel covers maintenance tips, real
          project walkthroughs, and behind-the-scenes looks at the Sunset team out in Portland, Dallas, and the
          surrounding area, so you know exactly what to expect before a technician ever knocks on your door.
        </p>
        <a href={business.social.youtube} target="_blank" rel="noopener noreferrer" class="rounded-md bg-brand-600 px-6 py-3 font-display font-semibold text-white hover:bg-brand-700">
          Watch on YouTube
        </a>
      </div>
    </Container>
  </section>

  <section class="bg-ink-50 py-16">
    <Container class="flex flex-col gap-8">
      <h2 class="text-center font-display text-2xl font-bold text-ink-900">What You’ll Find on Our Channel</h2>
      <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {topics.map((t) => (
          <div class="reveal-item rounded-xl border border-ink-100 bg-white p-6 text-center shadow-sm">
            <h3 class="font-display text-base font-bold text-ink-900">{t.title}</h3>
            <p class="mt-2 text-sm text-ink-500">{t.copy}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <WhyChooseUs />

  <FinalCTA />
</Layout>
