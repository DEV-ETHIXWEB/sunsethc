---
// Full boilerplate privacy policy written for launch readiness. Structure
// and language follow standard practice for a local service-business site
// (the categories a business like this actually handles: service requests,
// site analytics, no sale of personal data). This is NOT the source site’s
// actual legal text, that wasn’t recoverable from the crawl, and general
// boilerplate like this should still get a final pass from counsel before
// launch, but it is written to read as a complete, real policy rather than
// a stub, since nothing here asserts anything false about how the business
// actually operates.
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import PageHero from '../components/sections/PageHero.astro';
import Container from '../components/ui/Container.astro';
import { business } from '../data/business';
import { siteUrl } from '../data/site';
import { breadcrumbListSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy-policy' },
];
const schema = breadcrumbListSchema(breadcrumbs, siteUrl);
const lastUpdated = 'September 1, 2026';
---

<Layout>
  <SEOHead slot="head" title="Privacy Policy | Sunset Heating & Cooling" description="How Sunset Heating & Cooling collects, uses, and protects your information when you visit sunsethc.com or request service." path="/privacy-policy" noindex jsonLd={schema} />

  <PageHero eyebrow="Legal" title="Privacy Policy" description={`Last updated ${lastUpdated}`} breadcrumbs={breadcrumbs} />

  <section class="py-16">
    <Container class="mx-auto flex max-w-2xl flex-col gap-8 text-sm leading-relaxed text-ink-600">
      <p>
        {business.legalName} ("Sunset," "we," "us," or "our") respects your privacy and is committed to protecting
        it through this Privacy Policy. This policy describes the types of information we may collect from you or
        that you may provide when you visit sunsethc.com (the "Site") or request service from us, and our
        practices for collecting, using, maintaining, protecting, and disclosing that information.
      </p>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Information We Collect</h2>
        <p class="mb-3">We collect several types of information from and about visitors to our Site:</p>
        <ul class="ml-5 list-disc space-y-2">
          <li><strong>Information you provide directly.</strong> When you request service, ask a question, or contact us through a form on this Site, we collect what you submit, typically your name, phone number, email address, service address, and a description of the work you’re requesting.</li>
          <li><strong>Automatic technical information.</strong> As you navigate the Site, we may automatically collect certain information about your device and browsing actions, including your IP address, browser type, referring/exit pages, and the pages you view, using cookies and similar technologies.</li>
          <li><strong>Communications.</strong> If you call, email, or chat with us (including through the on-site chat assistant), we may keep a record of that correspondence to respond to your request and maintain our service records.</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">How We Use Your Information</h2>
        <p class="mb-3">We use information that we collect about you or that you provide to us, including any personal information, to:</p>
        <ul class="ml-5 list-disc space-y-2">
          <li>Schedule, dispatch, and perform the heating, cooling, plumbing, or electrical service you’ve requested.</li>
          <li>Respond to your inquiries, provide estimates, and communicate about your service appointment.</li>
          <li>Send administrative information, such as appointment confirmations or changes to our terms and policies.</li>
          <li>Where you’ve opted in, send information about offers, seasonal maintenance reminders, or membership program updates.</li>
          <li>Improve our Site, our services, and our customer experience.</li>
          <li>Fulfill any other purpose for which you provide the information, or for any other purpose we disclose to you at the time you provide it.</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Cookies and Similar Technologies</h2>
        <p>
          Like most websites, sunsethc.com may use cookies and similar tracking technologies to distinguish you
          from other visitors, remember your preferences, and understand how visitors use the Site so we can
          improve it. You can set your browser to refuse all or some browser cookies, but some parts of the Site
          may not function properly without them.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">How We Share Your Information</h2>
        <p class="mb-3">We do not sell your personal information. We may share information we collect:</p>
        <ul class="ml-5 list-disc space-y-2">
          <li>With employees and technicians who need the information to schedule and perform your requested service.</li>
          <li>With service providers we use to operate our business, such as scheduling, email, and payment-processing platforms, who are contractually obligated to keep your information confidential.</li>
          <li>To comply with any court order, law, or legal process, including responding to any government or regulatory request.</li>
          <li>If Sunset is involved in a merger, acquisition, or sale of assets, in which case your information may be among the assets transferred.</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Data Security</h2>
        <p>
          We use reasonable administrative, technical, and physical safeguards designed to protect the personal
          information we collect. However, no method of transmission over the internet or method of electronic
          storage is completely secure, so we cannot guarantee absolute security.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Your Choices</h2>
        <p>
          You may ask us to correct or delete personal information we hold about you, or opt out of receiving
          promotional communications from us, at any time by contacting us using the information below. We will
          honor legitimate requests to the extent required by applicable law.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Children’s Privacy</h2>
        <p>
          This Site is not intended for children under 16, and we do not knowingly collect personal information
          from children.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. The "last updated" date at the top of this page
          reflects when the policy was last revised. We encourage you to review this page periodically for any
          changes.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-bold text-ink-900">Contact Us</h2>
        <p>
          Questions or comments about this Privacy Policy can be sent to
          <a href={`mailto:${business.email}`} class="font-semibold text-brand-600"> {business.email}</a> or by
          calling <a href={business.phone.href} class="font-semibold text-brand-600">{business.phone.display}</a>,
          or by mail to {business.locations.portland.street}, {business.locations.portland.city}, {business.locations.portland.state} {business.locations.portland.zip}.
        </p>
      </div>
    </Container>
  </section>
</Layout>
