# SMTP2GO transactional email API key, used by src/pages/api/contact.ts to
# send the Contact/Request-Service form. Get one at
# https://app-us.smtp2go.com/settings/apikeys/ — required for the contact
# form to actually send email; without it the form returns a clear error
# telling visitors to call instead.
SMTP2GO_API_KEY=

# Optional — where form submissions are sent. Defaults to the business email
# in src/data/business.ts if unset.
CONTACT_TO_EMAIL=
